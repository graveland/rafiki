# Every input to the embedded PostgreSQL artifacts, pinned. build-*.sh source this
# file; bumping a value here is the whole of a version bump, plus the digests in
# pkg/embedpg/fetch.go once the release exists.

# The artifact version: <PostgreSQL release>-<build revision>. Bump the revision
# when only the extensions or bundled libraries change, so an installed tree is
# not mistaken for the new one (pkg/embedpg keys its tree directory by this).
PG_VERSION=18.6
BUILD_REV=1

# Extensions are pinned by commit, not only tag: a tag can be moved.
PGVECTOR_TAG=v0.8.7
PGVECTOR_COMMIT=f37c13f68b57d2c3472b2214fbcff699d6d34876
PG_TEXTSEARCH_TAG=v1.5.1
PG_TEXTSEARCH_COMMIT=fa142d049d08eac45a263f5abc250c8877ae076e

# darwin: EnterpriseDB's universal (x86_64 + arm64) binaries, repacked.
EDB_OSX_ZIP_URL=https://get.enterprisedb.com/postgresql/postgresql-18.6-1-osx-binaries.zip
EDB_OSX_ZIP_SHA256=2a6739fccbbc36474cb2446e4e7b4f377abb8471653d3a294e4e5092271e4796

# linux: built from source in ubuntu:24.04, whose digest is pinned in Dockerfile.linux.
# The newest glibc symbol version the artifact may reference: the host's floor.
GLIBC_MAX=2.38
PG_SOURCE_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f
