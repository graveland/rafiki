{
    "name": "@graveland/fundi-attach",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "dev": "bun ./src/main.ts",
        "build": "bun scripts/build.ts && bun scripts/copy-pi-assets.ts",
        "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/main.ts --outfile ../bin/fundi-attach",
        "build:darwin-x64": "bun build --compile --target=bun-darwin-x64   ./src/main.ts --outfile ../bin/fundi-attach",
        "build:linux-x64": "bun build --compile --target=bun-linux-x64    ./src/main.ts --outfile ../bin/fundi-attach",
        "build:linux-arm64": "bun build --compile --target=bun-linux-arm64  ./src/main.ts --outfile ../bin/fundi-attach"
    },
    "dependencies": {
        "@earendil-works/pi-agent-core": "file:../pi/packages/agent",
        "@earendil-works/pi-ai": "file:../pi/packages/ai",
        "@earendil-works/pi-coding-agent": "file:../pi/packages/coding-agent"
    },
    "devDependencies": {
        "bun-types": "^1.3.14",
        "typescript": "^6.0.3"
    }
}
