{
    "name": "@graveland/pic-attach",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "dev": "bun ./src/main.ts",
        "build": "bun build --compile --target=bun-darwin-arm64 ./src/main.ts --outfile ../bin/pic-attach && bun scripts/copy-pi-assets.ts",
        "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/main.ts --outfile ../bin/pic-attach",
        "build:darwin-x64": "bun build --compile --target=bun-darwin-x64   ./src/main.ts --outfile ../bin/pic-attach",
        "build:linux-x64": "bun build --compile --target=bun-linux-x64    ./src/main.ts --outfile ../bin/pic-attach",
        "build:linux-arm64": "bun build --compile --target=bun-linux-arm64  ./src/main.ts --outfile ../bin/pic-attach"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "^0.75.5"
    },
    "devDependencies": {
        "bun-types": "^1.3.14",
        "typescript": "^6.0.3"
    }
}
